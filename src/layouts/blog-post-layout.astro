---
import { Image } from 'astro:assets'
import { intlFormat } from 'date-fns/intlFormat'
import MainLayout from './main-layout.astro'
import type { CollectionEntry } from 'astro:content'
import { SITE_TITLE } from '~/consts'

type Blog = CollectionEntry<'blog'>
type Props = Blog['data'] & { slug?: Blog['id'] }

const { title, description, pubDate, updatedDate, image, slug } = Astro.props
---

<MainLayout
  title={`${title} | Blog | ${SITE_TITLE}`}
  description={description}
  image={image.src}
>
  <article class="mx-auto max-w-prose">
    <header class="flex flex-col">
      <Image
        width={1020}
        height={510}
        src={image}
        alt={title}
        class="mb-6 w-full rounded-lg object-cover"
        transition:name={slug}
      />
      <div class="mb-4 flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
        <span class="h-3 w-0.5 rounded-full bg-primary-500"></span>
        <time datetime={pubDate}>
          {
            intlFormat(pubDate, {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-balance text-zinc-900 sm:text-5xl dark:text-white">
        {title}
      </h1>
    </header>
    <div
      class="prose dark:prose-invert prose-pre:max-w-[90vw] sm:prose-pre:max-w-none prose-pre:border prose-pre:border-zinc-300 dark:prose-pre:border-zinc-700 mt-10"
    >
      <slot />
    </div>
  </article>
</MainLayout>
