---
import { compareDesc } from 'date-fns/compareDesc'
import { getCollection } from 'astro:content'
import { intlFormat } from 'date-fns/intlFormat'
import { SITE_TITLE } from '~/consts'
import { Button } from '~/components/button'
import MainLayout from '~/layouts/main-layout.astro'
import RssIcon from '~/components/icons/rss-icon.astro'

const posts = (
  await getCollection('blog', p => !p.data.draft || import.meta.env.DEV)
).sort((a, b) => compareDesc(a.data.pubDate, b.data.pubDate))
---

<MainLayout
  title={`Blog | ${SITE_TITLE}`}
  description="Notes, thoughts, and whatever else — collected in reverse chronological order."
>
  <div class="mx-auto flex w-full max-w-2xl flex-col">
    <header class="mb-10">
      <h1
        class="text-4xl font-bold tracking-tight text-balance text-zinc-900 sm:text-5xl dark:text-zinc-100"
      >
        Notes, thoughts, and whatever else.
      </h1>
      <p class="mt-4 max-w-prose text-base text-pretty text-zinc-600 dark:text-zinc-400">
        Collected in reverse chronological order.
      </p>
      <Button as="a" className="mt-4" href="/blog/rss.xml" variant="outline">
        <RssIcon /> RSS Feed
      </Button>
    </header>

    <div class="divide-y divide-(--surface-border)">
      {
        posts.map(post => (
          <article class="group py-8 first:pt-0">
            <a href={`/blog/${post.id}`} class="flex flex-col gap-2 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-500">
              <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400">
                <span class="h-3 w-0.5 rounded-full bg-primary-500" />
                <time datetime={post.data.pubDate}>
                  {intlFormat(post.data.pubDate, {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </div>
              <h2 class="text-lg font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-primary-600 dark:text-zinc-100 dark:group-hover:text-primary-400">
                {post.data.title}
              </h2>
              <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {post.data.description}
              </p>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</MainLayout>
