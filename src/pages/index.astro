---
import { SITE_DESCRIPTION, SITE_TITLE, FEATURES } from '~/consts'
import MainLayout from '~/layouts/main-layout.astro'
import ChevronRightIcon from '~/components/icons/chevron-right-icon.astro'
import { getCollection } from 'astro:content'
import { compareDesc } from 'date-fns/compareDesc'
import { intlFormat } from 'date-fns/intlFormat'

const posts = (
  await getCollection('blog', p => !p.data.draft || import.meta.env.DEV)
).sort((a, b) => compareDesc(a.data.pubDate, b.data.pubDate))

const recentPosts = posts.slice(0, 3)
---

<MainLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="mx-auto flex w-full max-w-2xl flex-col py-12 sm:py-20">
    <section>
      <p
        class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400"
      >
        Full stack developer
      </p>
      <h1
        class="text-5xl font-bold tracking-tight text-zinc-900 sm:text-7xl dark:text-white"
      >
        Allen Hansen
      </h1>
      <p
        class="mt-4 max-w-sm text-lg text-pretty text-zinc-500 sm:text-xl dark:text-zinc-400"
      >
        Writing about software, tooling, and the web.
      </p>
    </section>

    <section aria-label="Site sections" class="mt-14 flex flex-col gap-10 sm:mt-20">
      {
        recentPosts.length > 0 && (
          <div>
            <div class="mb-3 flex items-baseline justify-between gap-4">
              <p class="text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400">
                Recent posts
              </p>
              <a
                href="/blog"
                class="flex items-center gap-0.5 text-xs text-zinc-400 transition-colors hover:text-primary-600 dark:text-zinc-500 dark:hover:text-primary-400"
              >
                All posts
                <ChevronRightIcon class="size-3" />
              </a>
            </div>
            <div class="divide-y divide-(--surface-border)">
              {recentPosts.map(post => (
                <article class="group py-6 first:pt-0">
                  <a href={`/blog/${post.id}`} class="flex flex-col gap-2 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-500">
                    <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400">
                      <span class="h-2.5 w-0.5 rounded-full bg-primary-500" />
                      <time datetime={post.data.pubDate}>
                        {intlFormat(post.data.pubDate, {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </time>
                    </div>
                    <h2 class="text-base font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-primary-600 dark:text-zinc-100 dark:group-hover:text-primary-400">
                      {post.data.title}
                    </h2>
                    {post.data.description && (
                      <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                        {post.data.description}
                      </p>
                    )}
                  </a>
                </article>
              ))}
            </div>
          </div>
        )
      }

      {(FEATURES.now || FEATURES.about) && (
        <div class="grid gap-4 sm:grid-cols-2">
          {FEATURES.now && (
            <a href="/now" class="group flex flex-col gap-2">
              <p
                class="text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400"
              >
                Now
              </p>
              <p
                class="text-sm text-zinc-600 transition-colors group-hover:text-zinc-900 dark:text-zinc-400 dark:group-hover:text-zinc-100"
              >
                What I'm working on, learning, and thinking about right now.
              </p>
            </a>
          )}
          {FEATURES.about && (
            <a href="/about" class="group flex flex-col gap-2">
              <p
                class="text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400"
              >
                About
              </p>
              <p
                class="text-sm text-zinc-600 transition-colors group-hover:text-zinc-900 dark:text-zinc-400 dark:group-hover:text-zinc-100"
              >
                A bit about me, what I care about, and how to get in touch.
              </p>
            </a>
          )}
        </div>
      )}
    </section>
  </div>
</MainLayout>
