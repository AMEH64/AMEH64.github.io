---
import { SITE_TITLE } from '~/consts'
import MainLayout from '~/layouts/main-layout.astro'

const lastUpdated = 'May 2026'
---

<MainLayout
  title={`Now | ${SITE_TITLE}`}
  description="What Allen Hansen is working on and thinking about right now."
>
  <div class="mx-auto w-full max-w-prose">
    <header class="mb-10">
      <h1
        class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-white"
      >
        Now
      </h1>
      <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">
        What I'd tell a friend I hadn't seen in a year. Last updated {
          lastUpdated
        }.
      </p>
    </header>

    <div class="flex flex-col gap-10">
      <section>
        <h2
          class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400"
        >
          Working on
        </h2>
        <div class="prose dark:prose-invert">
          <ul>
            <li>Building and shipping features on a production web application at my day job</li>
            <li>This site — ongoing improvements to design and content</li>
          </ul>
        </div>
      </section>

      <section>
        <h2
          class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400"
        >
          Learning
        </h2>
        <div class="prose dark:prose-invert">
          <ul>
            <li>Astro 6 — new APIs, fonts, and content layer improvements</li>
            <li>Modern CSS — OKLCH color spaces, container queries, and cascade layers</li>
          </ul>
        </div>
      </section>

      <section>
        <h2
          class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400"
        >
          Reading &amp; watching
        </h2>
        <div class="prose dark:prose-invert">
          <ul>
            <li><em>A Philosophy of Software Design</em> — John Ousterhout</li>
            <li>Conference talks on TypeScript compiler internals and performance</li>
          </ul>
        </div>
      </section>

      <section>
        <h2
          class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400"
        >
          Side projects
        </h2>
        <div class="prose dark:prose-invert">
          <ul>
            <li>This site — the design, content, and tooling are all ongoing work</li>
          </ul>
        </div>
      </section>

      <section>
        <h2
          class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400"
        >
          Location
        </h2>
        <div class="prose dark:prose-invert">
          <p>Eastern US</p>
        </div>
      </section>
    </div>

    <div class="mt-12 border-t border-(--surface-border) pt-8">
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Inspired by the <a
          href="https://nownownow.com/about"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-primary-600 underline underline-offset-2 hover:text-primary-500 dark:text-primary-400"
          >/now movement</a
        >. Want to know more about me?
        <a
          href="/about"
          class="font-medium text-primary-600 underline underline-offset-2 hover:text-primary-500 dark:text-primary-400"
          >See the about page →</a
        >
      </p>
    </div>
  </div>
</MainLayout>
