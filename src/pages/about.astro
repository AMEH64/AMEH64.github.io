---
import { SITE_TITLE, FEATURES } from '~/consts'
import MainLayout from '~/layouts/main-layout.astro'
import { Button } from '~/components/button'
import GitHubIcon from '~/components/icons/git-hub-icon.astro'
import LinkedInIcon from '~/components/icons/linked-in-icon.astro'
---

<MainLayout
  title={`About | ${SITE_TITLE}`}
  description="A bit about Allen Hansen — full stack developer based in the US."
>
  <div class="mx-auto w-full max-w-prose">
    <header class="mb-10">
      <h1
        class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-white"
      >
        Allen Hansen
      </h1>
    </header>

    <div class="prose dark:prose-invert">
      <p>
        I'm a full stack developer with a focus on building web applications
        that are fast, accessible, and maintainable. I care about the craft of
        software — the kind of details that don't show up in a feature list but
        make a real difference to the people using what you build.
      </p>
      <p>
        By day I work on product software, primarily in TypeScript and React.
        Outside of that I tinker with side projects, contribute to open source
        when I can, and occasionally write about things I've learned or found
        interesting.
      </p>
      <p>
        I'm based in the eastern US.
      </p>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button
        as="a"
        href="https://github.com/AMEH64"
        target="_blank"
        rel="noopener noreferrer"
        variant="outline"
      >
        <GitHubIcon />
        GitHub
      </Button>
      <Button
        as="a"
        href="https://www.linkedin.com/in/allen-hansen"
        target="_blank"
        rel="noopener noreferrer"
        variant="outline"
      >
        <LinkedInIcon />
        LinkedIn
      </Button>
    </div>

    {FEATURES.now && (
      <div class="mt-10 border-t border-(--surface-border) pt-8">
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          Curious what I'm up to right now?
          <a
            href="/now"
            class="font-medium text-primary-600 underline underline-offset-2 hover:text-primary-500 dark:text-primary-400"
          >
            See my now page →
          </a>
        </p>
      </div>
    )}
  </div>
</MainLayout>
